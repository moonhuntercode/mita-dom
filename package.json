{
  "name": "mita-dom",
  "version": "2.8.0",
  "homepage": "https://github.com/moonhuntercode/mita-dom#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/moonhuntercode/mita-dom.git"
  },
  "bugs": {
    "url": "https://github.com/moonhuntercode/mita-dom/issues"
  },
  "author": "MoonHunterCode (Bolivia)",
  "license": "MIT",
  "keywords": [
    "pwa",
    "web-components",
    "signals",
    "reactivity",
    "dom",
    "vanillajs",
    "light-dom",
    "bolivia"
  ],
  "sideEffects": false,
  "description": "Librería Vanilla JS de alto rendimiento para Web Components nativos y reactividad granular por turnos (Mita).",
  "type": "module",
  "main": "./dist/mita-dom.js",
  "bin": {
    "mita": "./bin/mita.js"
  },
  "types": "./types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./dist/mita-dom.js"
    },
    "./signals": "./src/core/signals.js",
    "./async": "./src/core/asyncGraph.js",
    "./rust": "./src/core/rustGuard.js",
    "./ssr": "./src/core/ssr.js",
    "./props": "./src/core/propsYDefer.js",
    "./element": "./src/core/mitaElement.js",
    "./ui": "./src/utils/uiModeracionYComunidad.js",
    "./devtools": "./src/utils/fullstackYDevtools.js",
    "./package.json": "./package.json",
    "./docs/aprende/*.md": "./docs/aprende/*.md",
    "./docs/referencia/*.md": "./docs/referencia/*.md",
    "./changelogs/*.md": "./changelogs/*.md",
    "./*.md": "./*.md"
  },
  "files": [
    "dist",
    "bin",
    "types",
    "skills",
    "src",
    "!src/svg/**",
    "!src/**/*.test.js",
    "!src/core/seguridad.js",
    "*.md",
    "!LICENSE.md",
    "docs",
    "changelogs",
    "LICENSE"
  ],
  "private": false,
  "scripts": {
    "dev": "vite",
    "prebuild": "node scripts/auto-docs.js",
    "build": "vite build",
    "docs:auto": "node scripts/auto-docs.js",
    "test": "node --test --test-reporter=spec test/*.test.js",
    "test:vitest": "vitest run",
    "test:ui": "vitest --ui",
    "lint": "eslint .",
    "lint:css": "stylelint \"src/**/*.css\" --allow-empty-input",
    "qa": "npm run docs:auto && npm run build && npm run lint && npm run lint:css && npm run test",
    "release:check": "npm run qa && npm pack --dry-run",
    "preview": "vite preview",
    "changelog": "node scripts/generar-changelog.js"
  },
  "devDependencies": {
    "@vitest/ui": "^4.1.8",
    "esbuild": "^0.28.2",
    "eslint": "^10.4.1",
    "globals": "^17.6.0",
    "jsdom": "^29.1.1",
    "stylelint": "^17.15.0",
    "stylelint-config-standard": "^40.0.0",
    "terser": "^5.48.0",
    "vite": "^8.0.12",
    "vitest": "^4.1.8"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
